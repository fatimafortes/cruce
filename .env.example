# Copy to .env.local and fill in. Never commit .env.local (this repo is public).
# In production these live only in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API Keys (safe in the browser; RLS protects the data).
# Must be the publishable key (sb_publishable_…), not the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (server only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase secret key "cruce_server" (sb_secret_…). Server only: it bypasses RLS
# in the whole shared project. Vercel: Production only, Sensitive. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
